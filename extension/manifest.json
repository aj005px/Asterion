{
    "manifest_version": 3,
    "name": "Asterion",
    "version": "1.0",
    "description": "Local-first ML-powered browser-tab prioritization assistant",
    "permissions": [
        "tabs",
        "storage"
    ],
    "host_permissions": [
        "http://127.0.0.1:8000/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Asterion"
    },
    "icons": {
        "16": "icons/icon16.svg",
        "32": "icons/icon32.svg",
        "48": "icons/icon48.svg",
        "128": "icons/icon128.svg"
    }
}
